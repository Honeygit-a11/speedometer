# Production Speed Test Worker Endpoints
# Replace with your deployed Cloudflare Worker domains / custom subdomains.

# Single server (simple):
NEXT_PUBLIC_SPEEDTEST_WORKER_URL=https://speed-edge.yourdomain.workers.dev

# Multi-server registry (recommended for geographically distributed edge nodes).
# The engine probes each by latency and selects the fastest healthy server,
# with automatic failover if the best server fails.
# NEXT_PUBLIC_SPEEDTEST_SERVERS=[{"id":"us-east","name":"US East","region":"us-east","baseUrl":"https://speed-edge-us.yourdomain.workers.dev"},{"id":"eu-west","name":"EU West","region":"eu-west","baseUrl":"https://speed-edge-eu.yourdomain.workers.dev"},{"id":"asia","name":"Asia","region":"asia","baseUrl":"https://speed-edge-asia.yourdomain.workers.dev"}]
