# Production Speed Test Worker Endpoints
# Replace with your deployed Cloudflare Worker domains / custom subdomains.

# Single server (simple):
NEXT_PUBLIC_SPEEDTEST_WORKER_URL=https://speed-edge.yourdomain.workers.dev

# Multi-server registry (recommended for geographically distributed edge nodes).
# The engine probes each by latency + /health and selects the fastest healthy
# server, with automatic failover if the best server fails.
#
# Per-server fields:
#   id        — unique identifier (required)
#   name      — human-readable label (required)
#   region    — geographic region tag (required)
#   baseUrl   — worker origin (required)
#   backend   — "standard" (Cloudflare) | "librespeed" (optional, default "standard")
#   enabled   — false to exclude from discovery (optional, default true)
#   priority  — lower = preferred; used as tiebreaker after measured latency (optional, default 0)
#
# Each server must expose: /ping, /download, /upload, /health (standard only),
# and /getIP (client identity lookup shown in the UI).
NEXT_PUBLIC_SPEEDTEST_SERVERS=[{"id":"us-east","name":"US East","region":"us-east","baseUrl":"https://speed-edge-us.yourdomain.workers.dev","priority":1},{"id":"eu-west","name":"EU West","region":"eu-west","baseUrl":"https://speed-edge-eu.yourdomain.workers.dev","priority":2},{"id":"asia","name":"Asia","region":"asia","baseUrl":"https://speed-edge-asia.yourdomain.workers.dev","priority":3},{"id":"staging","name":"Staging","region":"staging","baseUrl":"https://staging-edge.yourdomain.workers.dev","enabled":false}]
