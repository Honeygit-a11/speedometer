# ==============================================================================
# SpeedPulse — Environment Configuration Template
# Copy this file to .env.local for local development, or set in Vercel / Cloudflare
# ==============================================================================

# Cloudflare Worker URL (recommended — measures real internet path to edge)
# Local Development:
NEXT_PUBLIC_SPEEDTEST_WORKER_URL=http://localhost:8787
# Production:
# NEXT_PUBLIC_SPEEDTEST_WORKER_URL=https://speed-edge.yourdomain.workers.dev

# Multi-server registry (optional, recommended for production)
# Each server must expose /ping, /download, /upload, /health (standard only),
# and /getIP. Optional per-server fields: backend ("standard"|"librespeed"),
# enabled (false excludes from discovery), priority (lower = preferred tiebreak).
# NEXT_PUBLIC_SPEEDTEST_SERVERS=[{"id":"us-east","name":"US East","region":"us-east","baseUrl":"https://speed-edge-us.yourdomain.workers.dev","backend":"standard","priority":1}]

# Remote LibreSpeed backend (Railway) — only when deployed remotely:
# NEXT_PUBLIC_LIBRESPEED_URL=https://your-librespeed.up.railway.app

# Local dev only — allows localhost servers (measures loopback, NOT ISP speed):
# NEXT_PUBLIC_ALLOW_LOCAL_SERVERS=true
