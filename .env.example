# ==============================================================================
# SpeedPulse — Environment Configuration Template
# Copy this file to .env.local for local development, or set in Vercel / Cloudflare
# ==============================================================================

# Cloudflare Worker URL (recommended — measures real internet path to edge)
# Local Development:
NEXT_PUBLIC_SPEEDTEST_WORKER_URL=http://localhost:8787
# Production:
# NEXT_PUBLIC_SPEEDTEST_WORKER_URL=https://speed-edge.yourdomain.workers.dev

# Multi-server registry (Fast.com-style distributed configuration — Phase 15 of antigravitity.file)
# Configure multi-region nodes (Asia, Europe, US East, etc.). The engine automatically
# latency-probes each candidate, ranks them, selects the best node, and fails over on drop:
# NEXT_PUBLIC_SPEEDTEST_SERVERS=[{"id":"railway-backend","name":"Railway Cloud Server","region":"auto","baseUrl":"https://speedometer.up.railway.app","backend":"librespeed"},{"id":"cf-edge-global","name":"Cloudflare Global Edge","region":"global","baseUrl":"https://speed-edge.yourdomain.workers.dev","backend":"standard"}]

# Remote LibreSpeed backend (Railway) — single server setup:
# NEXT_PUBLIC_LIBRESPEED_URL=https://speedometer.up.railway.app

# Local dev only — allows localhost servers (measures loopback, NOT ISP speed):
# NEXT_PUBLIC_ALLOW_LOCAL_SERVERS=true
