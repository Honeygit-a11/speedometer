# LibreSpeed Backend URL (Railway deployed or local backend)
# When set, the engine connects directly to the LibreSpeed backend service
# e.g., on Railway: https://your-librespeed.up.railway.app
NEXT_PUBLIC_LIBRESPEED_URL=http://localhost:8888

# Legacy / Edge Worker Endpoint URL
NEXT_PUBLIC_SPEEDTEST_WORKER_URL=http://localhost:8787

# Multi-server registry (optional). JSON array of test servers; the engine probes
# each and selects the lowest-latency healthy one, with automatic failover.
# Optional per-server fields: backend ("standard"|"librespeed"), enabled,
# priority (lower = preferred tiebreak).
# NEXT_PUBLIC_SPEEDTEST_SERVERS=[{"id":"local","name":"Local LibreSpeed","region":"local","baseUrl":"http://localhost:8888"}]

